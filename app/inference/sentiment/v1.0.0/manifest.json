{
    "name": "afro-xlmr-sentiment",
    "version": "1.0.0",
    "display_name": "Afro-XLMR Sentiment Classifier",
  
    "task": {
      "type": "text-classification",
      "subtask": "sentiment-analysis",
      "num_labels": 3
    },
  
    "base_model": {
      "name": "Davlan/afro-xlmr-base",
      "type": "transformer",
      "architecture": "XLM-RoBERTa"
    },
  
    "labels": {
      "0": "negative",
      "1": "neutral",
      "2": "positive"
    },
  
    "languages": [
      "am",
      "om",
      "en"
    ],
  
    "inference": {
      "max_length": 128,
      "truncation": true,
      "padding": false,
      "probability_function": "softmax",
      "prediction_strategy": "argmax"
    },
  
    "training": {
      "framework": "transformers",
      "transformers_version": "4.55.4",
      "torch_version": "2.8.0",
      "training_device": "cuda",
      "training_gpu": "Tesla T4",
      "epochs": 3
    },
  
    "evaluation": {
      "accuracy": 0.49974987493746875,
      "macro_f1": 0.4950476879429711,
      "weighted_f1": 0.5662142891708098
    },
  
    "artifacts": {
      "model": "model.safetensors",
      "config": "config.json",
      "tokenizer": "tokenizer.json",
      "tokenizer_config": "tokenizer_config.json",
      "special_tokens": "special_tokens_map.json"
    },
  
    "runtime": {
      "supported_devices": [
        "cuda",
        "mps",
        "cpu"
      ],
      "default_device": "auto"
    },
  
    "status": "beta",
  
    "created_at": "2026-09-07",
  
    "description": "Fine-tuned Afro-XLMR sentiment classification model for municipal social-media analysis. This version is intended for integration testing and evaluation."
  }